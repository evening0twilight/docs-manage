# ===================================================================
# 文档管理系统 - 环境变量模板
# 复制为 .env 并填入真实值:  cp .env.example .env
# 标 [必填] 的变量缺失时应用会启动失败(已启用启动校验)
# ===================================================================

# ---------- 运行环境 ----------
NODE_ENV=development            # development | production | test
PORT=3000

# ---------- 数据库 (MySQL) [必填] ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=docs_user
DB_PASSWORD=change-me           # [必填] 生产环境必须为非空
DB_NAME=docs_manage

# ---------- JWT 鉴权 [必填] ----------
# 生产环境务必使用足够随机的强密钥(例如 openssl rand -base64 48)
JWT_SECRET=change-me-access-secret          # [必填]
JWT_REFRESH_SECRET=change-me-refresh-secret # [必填]
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 跨域 (CORS) ----------
# HTTP 与 WebSocket 共用;逗号分隔。未配置时回退到本地开发来源。
# 生产示例: https://your-domain.com,http://your-server-ip
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 前端地址(用于邮件中的链接等)
FRONTEND_URL=http://127.0.0.1:5173

# ---------- Yjs/CRDT 协同 ----------
# Hocuspocus 协同服务监听端口(独立于 HTTP 端口),前端 VITE_YJS_WS_URL 指向它
YJS_PORT=1234

# ---------- 邮件服务 ----------
# MAIL_PROVIDER: smtp | resend
MAIL_PROVIDER=smtp
MAIL_STRATEGY=smart             # smart | qq | 163

# SMTP - QQ 邮箱
MAIL_QQ_USER=
MAIL_QQ_PASSWORD=               # QQ 邮箱授权码(非登录密码)
MAIL_QQ_FROM=
# SMTP - 163 邮箱
MAIL_163_USER=
MAIL_163_PASSWORD=
MAIL_163_FROM=

# Resend(当 MAIL_PROVIDER=resend 时必填)
RESEND_API_KEY=
RESEND_FROM=                    # 使用 resend 时必填,例如 noreply@your-domain.com

# ---------- 文件上传 (腾讯云 COS) ----------
# 配置完整后才启用上传;缺失时上传接口返回 503(不影响启动)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_DOMAIN=
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760          # 10MB

# ---------- AI 助手 ----------
# AI_USE_MOCK=true 时使用本地 mock,无需真实 Key
AI_USE_MOCK=true
AI_PROVIDER=mock                # mock | zhipu | openai
AI_API_KEY=
AI_API_URL=
AI_MODEL=mock-model
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
